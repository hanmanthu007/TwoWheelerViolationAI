# ==============================================================================
# TwoWheelerViolationAI - Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure your local settings.

# ------------------------------------------------------------------------------
# Google Gemini Multimodal Vision API (Optional Fallback for P3)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left blank, the system automatically runs offline with local EasyOCR (P1)
# and flags ambiguous plates as 'UNCERTAIN_LOCAL' for officer review.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Storage & Database Paths
# ------------------------------------------------------------------------------
DATABASE_PATH=traffic_violations.db
EVIDENCE_DIR=evidence
CHALLANS_DIR=challans
PDF_REPORTS_DIR=challans/pdf_reports

# ------------------------------------------------------------------------------
# Video Tracking & Deduplication Settings
# ------------------------------------------------------------------------------
# Cooldown period in seconds before issuing another violation for the same vehicle
TRACKING_COOLDOWN_SECONDS=60
TRACKER_CONFIG=bytetrack.yaml

# ------------------------------------------------------------------------------
# Surveillance Camera & CCTV Stream Defaults
# ------------------------------------------------------------------------------
# RTSP URL for live IP surveillance stream (leave empty for file upload mode)
DEFAULT_RTSP_STREAM_URL=
SURVEILLANCE_LOCATION=Surveillance Sector #04 - Junction Road Cam
